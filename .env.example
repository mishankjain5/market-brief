# Copy this file to .env for local testing
# NEVER commit the real .env file to GitHub

GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_TOKEN=xxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHANNEL_ID=@YourChannelUsername        # or -100xxxxxxxxxx (numeric ID)

# Optional: WhatsApp via CallMeBot (free, personal only)
CALLMEBOT_PHONE=+91XXXXXXXXXX                   # your WhatsApp number with country code
CALLMEBOT_APIKEY=xxxxxxx                        # from CallMeBot activation
